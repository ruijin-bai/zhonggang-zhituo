# Runtime mode
# development: local engineering; production: strict database-only mode.
APP_ENV=development
DEMO_MODE=true
ALLOW_DEMO_FALLBACK=true

# Web
NEXT_PUBLIC_APP_NAME=中港智拓
API_BASE_URL=http://127.0.0.1:8000
# Keep true only for local/demo builds. Production must set false.
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=true

# API / Database
DATA_BACKEND=auto
DATABASE_URL=postgresql+psycopg://zhituo:zhituo@127.0.0.1:5432/zhituo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Responses-compatible AI provider. Models are deployment choices, not repository defaults.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_EXTRACTION=
AI_MODEL_ANALYSIS=
AI_TIMEOUT_SECONDS=45

# Production baseline example (do not copy credentials into Git):
# APP_ENV=production
# DEMO_MODE=false
# ALLOW_DEMO_FALLBACK=false
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false
# DATA_BACKEND=database
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<db-host>:5432/zhituo
# CORS_ORIGINS=https://zhituo.example.com
