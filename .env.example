# Runtime mode
APP_ENV=development
DEMO_MODE=true
ALLOW_DEMO_FALLBACK=true

# API authentication
# development_header is permitted only outside production.
# Production should use trusted_proxy or oidc.
AUTH_MODE=development_header
DEV_USER_EMAIL=admin@zhituo.local
AUTH_PROXY_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_EMAIL_CLAIM=email

# Web / Backend-for-Frontend
NEXT_PUBLIC_APP_NAME=中港智拓
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=true
# Server-only BFF transport mode. In production, trusted_proxy is recommended for the Web UI
# behind an identity-aware ingress. Never expose API_TRUSTED_PROXY_SECRET as NEXT_PUBLIC_*.
API_AUTH_MODE=development_header
API_TRUSTED_PROXY_SECRET=

# API / Database
DATA_BACKEND=auto
DATABASE_URL=postgresql+psycopg://zhituo:zhituo@127.0.0.1:5432/zhituo
DATABASE_RLS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background jobs
# development may keep inline for old synchronous endpoints; production must use queue.
JOB_MODE=inline
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=90
CELERY_TASK_TIME_LIMIT_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400
JOB_STUCK_AFTER_SECONDS=300

# Source document storage
# Local storage is development/test only. Production requires an S3-compatible backend.
DOCUMENT_STORE_BACKEND=local
DOCUMENT_STORE_LOCAL_PATH=./data/objects
DOCUMENT_STORE_S3_BUCKET=
DOCUMENT_STORE_S3_REGION=us-east-1
DOCUMENT_STORE_S3_ENDPOINT_URL=
DOCUMENT_STORE_S3_FORCE_PATH_STYLE=false
# Optional server-side encryption: empty, AES256, or aws:kms.
DOCUMENT_STORE_S3_SSE=
DOCUMENT_STORE_S3_KMS_KEY_ID=
# S3 credentials are intentionally not custom application settings. Use the standard AWS SDK
# credential chain (workload identity / instance role / environment / shared credentials).

# Scheduled source monitoring
# Beat checks for due subscriptions every minute; each claimed subscription is dispatched as
# an independent worker task. Lease duration must exceed the Celery hard task timeout.
SOURCE_SCAN_DISPATCH_INTERVAL_SECONDS=60
SOURCE_SCAN_MIN_INTERVAL_SECONDS=300
SOURCE_SCAN_LEASE_SECONDS=300
SOURCE_SCAN_MAX_BACKOFF_SECONDS=86400
SOURCE_SCAN_AUTO_PAUSE_FAILURES=8
SOURCE_SCAN_DISPATCH_BATCH_SIZE=50

# Candidate Opportunity Pipeline
# Every newly archived normalized SourceDocument first receives durable PostgreSQL processing
# state. Beat only dispatches due rows; workers perform project detection and create a human-
# reviewable OpportunityDraft. Lease duration must exceed the Celery hard task timeout.
CANDIDATE_DISPATCH_INTERVAL_SECONDS=30
CANDIDATE_LEASE_SECONDS=300
CANDIDATE_MAX_ATTEMPTS=5
CANDIDATE_MAX_BACKOFF_SECONDS=3600
CANDIDATE_DISPATCH_BATCH_SIZE=50
# High threshold by design: automatically merge only very similar pending candidates. Similarity
# to an already-confirmed Opportunity remains a human review hint rather than automatic merging.
CANDIDATE_DRAFT_DUPLICATE_THRESHOLD=0.88

# Pursuit Reminder / Escalation
# Beat reconciles durable in-product reminders. These thresholds belong to the business fact layer;
# delivery adapters consume the resulting Reminder ledger independently.
PURSUIT_REMINDER_RECONCILE_INTERVAL_SECONDS=300
PURSUIT_DUE_SOON_HOURS=48
PURSUIT_OVERDUE_ESCALATION_HOURS=72
PURSUIT_BLOCKED_ESCALATION_HOURS=24
PURSUIT_REVIEW_ESCALATION_HOURS=48

# Pursuit Reminder Email Delivery
# Disabled by default. When enabled, Reminder facts are staged into a durable PostgreSQL outbox,
# claimed by Beat/Worker with a lease token, and retried with exponential backoff.
PURSUIT_EMAIL_DELIVERY_ENABLED=false
PURSUIT_EMAIL_DISPATCH_INTERVAL_SECONDS=30
PURSUIT_EMAIL_LEASE_SECONDS=180
PURSUIT_EMAIL_MAX_ATTEMPTS=5
PURSUIT_EMAIL_MAX_BACKOFF_SECONDS=3600
PURSUIT_EMAIL_DISPATCH_BATCH_SIZE=50
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=中港智拓
SMTP_TIMEOUT_SECONDS=20
# Optional direct link included in notification email. Production values must use HTTPS.
NOTIFICATION_PUBLIC_BASE_URL=

# Observability
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID

# HTTP security. The ingress/WAF must enforce independent limits as well.
MAX_REQUEST_BODY_BYTES=2000000
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=300

# Responses-compatible AI provider. Models are deployment choices, not repository defaults.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_EXTRACTION=
AI_MODEL_ANALYSIS=
AI_TIMEOUT_SECONDS=45

# Production trusted-proxy baseline (do not copy credentials into Git):
# APP_ENV=production
# DEMO_MODE=false
# ALLOW_DEMO_FALLBACK=false
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false
# DATA_BACKEND=database
# DATABASE_RLS_ENABLED=true
# JOB_MODE=queue
# AUTH_MODE=trusted_proxy
# AUTH_PROXY_SECRET=<api-secret-manager-injected-min-32-chars>
# API_AUTH_MODE=trusted_proxy
# API_TRUSTED_PROXY_SECRET=<same-trust-domain-secret-injected-only-into-web-server>
# DATABASE_URL=postgresql+psycopg://<runtime-user>:<password>@<db-host>:5432/zhituo
# REDIS_URL=redis://<redis-host>:6379/0
# DOCUMENT_STORE_BACKEND=s3
# DOCUMENT_STORE_S3_BUCKET=zhituo-production-documents
# DOCUMENT_STORE_S3_REGION=<deployment-region>
# DOCUMENT_STORE_S3_ENDPOINT_URL=https://<s3-compatible-endpoint>  # omit for AWS S3
# DOCUMENT_STORE_S3_FORCE_PATH_STYLE=false
# DOCUMENT_STORE_S3_SSE=AES256
# SOURCE_SCAN_DISPATCH_INTERVAL_SECONDS=60
# SOURCE_SCAN_MIN_INTERVAL_SECONDS=300
# SOURCE_SCAN_LEASE_SECONDS=300
# SOURCE_SCAN_MAX_BACKOFF_SECONDS=86400
# SOURCE_SCAN_AUTO_PAUSE_FAILURES=8
# SOURCE_SCAN_DISPATCH_BATCH_SIZE=50
# CANDIDATE_DISPATCH_INTERVAL_SECONDS=30
# CANDIDATE_LEASE_SECONDS=300
# CANDIDATE_MAX_ATTEMPTS=5
# CANDIDATE_MAX_BACKOFF_SECONDS=3600
# CANDIDATE_DISPATCH_BATCH_SIZE=50
# CANDIDATE_DRAFT_DUPLICATE_THRESHOLD=0.88
# PURSUIT_REMINDER_RECONCILE_INTERVAL_SECONDS=300
# PURSUIT_DUE_SOON_HOURS=48
# PURSUIT_OVERDUE_ESCALATION_HOURS=72
# PURSUIT_BLOCKED_ESCALATION_HOURS=24
# PURSUIT_REVIEW_ESCALATION_HOURS=48
# PURSUIT_EMAIL_DELIVERY_ENABLED=true
# PURSUIT_EMAIL_DISPATCH_INTERVAL_SECONDS=30
# PURSUIT_EMAIL_LEASE_SECONDS=180
# PURSUIT_EMAIL_MAX_ATTEMPTS=5
# PURSUIT_EMAIL_MAX_BACKOFF_SECONDS=3600
# PURSUIT_EMAIL_DISPATCH_BATCH_SIZE=50
# SMTP_HOST=<smtp-service>
# SMTP_PORT=587
# SMTP_USERNAME=<secret-manager-injected-user>
# SMTP_PASSWORD=<secret-manager-injected-password>
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
# SMTP_FROM_EMAIL=zhituo@example.com
# SMTP_FROM_NAME=中港智拓
# SMTP_TIMEOUT_SECONDS=20
# NOTIFICATION_PUBLIC_BASE_URL=https://zhituo.example.com
# CORS_ORIGINS=https://zhituo.example.com
# IDEMPOTENCY_TTL_SECONDS=86400
# AUTHENTICATED_RATE_LIMIT_PER_MINUTE=300
# LOG_LEVEL=INFO

# Production direct-OIDC API alternative:
# AUTH_MODE=oidc
# OIDC_ISSUER=https://id.example.com/
# OIDC_AUDIENCE=zhituo-api
# OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
# OIDC_EMAIL_CLAIM=email
# API_AUTH_MODE=oidc  # only when the Web ingress forwards a valid Bearer token to Next.js

# trusted_proxy deployment requirement:
# The identity-aware ingress must strip client-supplied X-Zhituo-User and protected headers,
# inject its authenticated X-Zhituo-User toward Web, and prevent direct public access to FastAPI.
# Next.js BFF injects X-Zhituo-Gateway-Secret server-side when calling FastAPI.
# Multi-organization users must explicitly select X-Zhituo-Organization.
# Clients should send a stable Idempotency-Key on state-changing writes and queued POST requests.
