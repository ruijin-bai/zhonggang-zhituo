# Runtime mode
APP_ENV=development
DEMO_MODE=true
ALLOW_DEMO_FALLBACK=true

# Authentication
# development_header is permitted only outside production.
# Production should use trusted_proxy or oidc.
AUTH_MODE=development_header
DEV_USER_EMAIL=admin@zhituo.local
AUTH_PROXY_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_EMAIL_CLAIM=email

# Web
NEXT_PUBLIC_APP_NAME=中港智拓
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=true

# API / Database
DATA_BACKEND=auto
DATABASE_URL=postgresql+psycopg://zhituo:zhituo@127.0.0.1:5432/zhituo
DATABASE_RLS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background jobs
# development may keep inline for old synchronous endpoints; production must use queue.
JOB_MODE=inline
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=90
CELERY_TASK_TIME_LIMIT_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400

# Observability
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID

# HTTP security. The ingress/WAF must enforce independent limits as well.
MAX_REQUEST_BODY_BYTES=2000000
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=300

# Responses-compatible AI provider. Models are deployment choices, not repository defaults.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_EXTRACTION=
AI_MODEL_ANALYSIS=
AI_TIMEOUT_SECONDS=45

# Production trusted-proxy baseline (do not copy credentials into Git):
# APP_ENV=production
# DEMO_MODE=false
# ALLOW_DEMO_FALLBACK=false
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false
# DATA_BACKEND=database
# DATABASE_RLS_ENABLED=true
# JOB_MODE=queue
# AUTH_MODE=trusted_proxy
# AUTH_PROXY_SECRET=<inject-from-secret-manager-min-32-chars>
# DATABASE_URL=postgresql+psycopg://<runtime-user>:<password>@<db-host>:5432/zhituo
# REDIS_URL=redis://<redis-host>:6379/0
# CORS_ORIGINS=https://zhituo.example.com
# IDEMPOTENCY_TTL_SECONDS=86400
# AUTHENTICATED_RATE_LIMIT_PER_MINUTE=300
# LOG_LEVEL=INFO

# Production direct-OIDC alternative:
# AUTH_MODE=oidc
# OIDC_ISSUER=https://id.example.com/
# OIDC_AUDIENCE=zhituo-api
# OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
# OIDC_EMAIL_CLAIM=email

# trusted_proxy deployment requirement:
# The reverse proxy / SSO gateway must strip client-supplied X-Zhituo-User and
# X-Zhituo-Gateway-Secret headers, then inject its own authenticated values before forwarding.
# Multi-organization users must explicitly select X-Zhituo-Organization.
# Clients should send a stable Idempotency-Key on queued POST requests when they may retry.
