#cloud-config
package_update: true
package_upgrade: false
packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - openssl

users:
  - default
  - name: zhituo
    gecos: Zhituo deploy user
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true

write_files:
  - path: /etc/systemd/system/zhituo-pilot.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Zhituo Oracle Internal Pilot
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      ConditionPathExists=/opt/zhituo/current/deploy/pilot/.env

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      User=zhituo
      Group=zhituo
      WorkingDirectory=/opt/zhituo/current
      Environment=ZHITUO_PILOT_ENV_FILE=/opt/zhituo/current/deploy/pilot/.env
      ExecStart=/opt/zhituo/current/scripts/pilot-up.sh --resume
      ExecStop=/opt/zhituo/current/scripts/pilot-down.sh
      TimeoutStartSec=900
      TimeoutStopSec=180

      [Install]
      WantedBy=multi-user.target

runcmd:
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker
  - usermod -aG docker zhituo
  - install -d -o zhituo -g zhituo -m 0750 /opt/zhituo /var/lib/zhituo/secrets /var/lib/zhituo/backups
  - install -d -o zhituo -g zhituo -m 0700 /home/zhituo/.ssh
  - 'sudo -u zhituo ssh-keygen -q -t ed25519 -N "" -C "${display_name}-github-readonly" -f /home/zhituo/.ssh/id_ed25519'
  - systemctl daemon-reload
  - systemctl enable zhituo-pilot.service

final_message: "Zhituo host initialization completed. Register /home/zhituo/.ssh/id_ed25519.pub as a read-only GitHub deploy key, then run the repository bootstrap script."
