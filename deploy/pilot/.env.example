# Generated image tags. pilot-up.sh replaces these with the deployed Git SHA.
ZHITUO_API_IMAGE=zhituo-api:pilot-example
ZHITUO_WEB_IMAGE=zhituo-web:pilot-example
DEPLOYED_GIT_SHA=not-deployed
PREVIOUS_GIT_SHA=

# pilot-up.sh generates strong random values in deploy/pilot/.env (never commit that file).
POSTGRES_OWNER_PASSWORD=<generated-secret>
POSTGRES_RUNTIME_PASSWORD=<generated-secret>
POSTGRES_BACKUP_PASSWORD=<generated-secret>
REDIS_PASSWORD=<generated-secret>
MINIO_ROOT_USER=zhituo-pilot
MINIO_ROOT_PASSWORD=<generated-secret>
AUTH_PROXY_SECRET=<generated-secret>
METRICS_TOKEN=<generated-secret>

# Internal MinIO uses a local TLS certificate generated by pilot-up.sh.
MINIO_BUCKET=zhituo-pilot-documents
PILOT_SECRETS_DIR=/var/lib/zhituo/secrets
PILOT_BACKUP_DIR=/var/lib/zhituo/backups
PILOT_BACKUP_RETENTION_DAYS=14

# Caddy binds only to loopback by default. Use SSH forwarding or Cloudflare Tunnel.
PILOT_BIND_ADDRESS=127.0.0.1
PILOT_HTTP_PORT=8080
PILOT_BASIC_AUTH_USER=pilot
PILOT_BASIC_AUTH_PASSWORD=<generated-secret>
PILOT_BASIC_AUTH_HASH='<generated-caddy-bcrypt-hash>'

# This becomes the fixed Internal Pilot identity after ingress authentication.
PILOT_ADMIN_EMAIL=pilot.owner@example.com
PILOT_ADMIN_DISPLAY_NAME=Pilot Administrator
PILOT_ORGANIZATION_NAME=Zhituo Pilot
PILOT_ORGANIZATION_CODE=ZHITUO-PILOT

CELERY_WORKER_CONCURRENCY=1
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=300
SOURCE_SCAN_MIN_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# Optional AI provider. Empty means deterministic non-AI fallbacks remain explicit.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_EXTRACTION=
AI_MODEL_ANALYSIS=

# Optional. Configure a Cloudflare Access policy before setting a tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=
